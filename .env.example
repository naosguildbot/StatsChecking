# Copy this file to ".env" and paste your PERSONAL Hypixel API key.
# Get one at https://developer.hypixel.net/  (create an app -> generate key).
#
# IMPORTANT (Hypixel ToS): never share this key, never commit it, and never
# expose it to the browser. This app keeps it server-side only.
HYPIXEL_API_KEY=your-personal-api-key-here

# Optional: port the local server listens on (default 3000).
PORT=3000
